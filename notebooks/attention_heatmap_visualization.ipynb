    "    \"        tokens = encoder_output  # [B, N, D]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    B, N, D = tokens.shape\\n\",\n",
    "    \"    T = num_frames\\n\",\n",
    "    \"    spatial_tokens = N // T\\n\",\n",
    "    \"    H_patch = W_patch = int(np.sqrt(spatial_tokens))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if H_patch * W_patch != spatial_tokens:\\n\",\n",
    "    \"        logger.warning(f\\\"Non-square grid: {N} / {T} = {spatial_tokens} → √ ≈ {H_patch}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    logger.info(f\\\"✓ Spatial grid: {H_patch} × {W_patch} (T={T})\\\")\\n\",\n",
    "    \"    return H_patch, W_patch\\n\",\n",
    "    \"\\n\",\n",
    "    \"logger.info(\\\"✓ Model loading functions defined\\\")\"\n",
