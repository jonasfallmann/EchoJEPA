    "    \"    logger.info(f\\\"✓ Encoder loaded. Embed dim: {encoder.embed_dim}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Load probe checkpoint\\n\",\n",
    "    \"    if not os.path.exists(probe_checkpoint_path):\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Probe checkpoint not found: {probe_checkpoint_path}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    checkpoint_dict = robust_checkpoint_loader(probe_checkpoint_path, map_location=device)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Find best head\\n\",\n",
    "    \"    best_head_idx = 0\\n\",\n",
    "    \"    if \\\"best_val_acc_per_head\\\" in checkpoint_dict:\\n\",\n",
    "    \"        best_val_accs = checkpoint_dict[\\\"best_val_acc_per_head\\\"]\\n\",\n",
    "    \"        best_head_idx = int(np.argmax(best_val_accs))\\n\",\n",
    "    \"        logger.info(f\\\"✓ Found {len(best_val_accs)} heads. Best: head {best_head_idx} (val_acc={best_val_accs[best_head_idx]:.4f})\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create classifier\\n\",\n",
    "    \"    num_classes = args_data.get(\\\"num_classes\\\")\\n\",\n",
