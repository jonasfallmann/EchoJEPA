    "    \"    \\n\",\n",
    "    \"    return encoder, classifier, best_head_idx\\n\",\n",
    "    \"\\n\",\n",
    "    \"def extract_spatial_dimensions(encoder_output: torch.Tensor, num_frames: int) -> Tuple[int, int]:\\n\",\n",
